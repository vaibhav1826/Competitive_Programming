#include <bits/stdc++.h>
using namespace std;

void merge(vector<int> &arr, int l, int m, int r)
{
    int i = l, j = m + 1;
    vector<int> temp;
    while (i <= m && j <= r)
    {
        if (arr[i] > arr[j])
        {
            temp.push_back(arr[i++]);
        }
        else
        {
            temp.push_back(arr[j++]);
        }
    }
    while (i <= m)
    {
        temp.push_back(arr[i++]);
    }
    while (j <= r)
    {
        temp.push_back(arr[j++]);
    }
    for (int k = l; k <= r; k++)
    {
        arr[k] = temp[k - l];
    }
};

void mergesort(vector<int> &arr, int l, int r)
{
    if (l >= r)
    {
        return;
    }
    int m = (l + (r - 1)) / 2;
    mergesort(arr, l, m);
    mergesort(arr, m + 1, r);
    merge(arr, l, m, r);
};

int main()
{
    vector<int> arr = {1, 4, 3, 2, 5};
    int l = 0;
    int r = arr.size() - 1;
    mergesort(arr, l, r);
    for (int i = 0; i < arr.size(); i++)
    {
        cout << arr[i] << " ";
    }
}